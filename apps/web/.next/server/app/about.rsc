er-b py-20 sm:py-24 border-cream/10 bg-mesh-cream text-cream","children":[null,["$","div",null,{"className":"relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"max-w-3xl","children":[["$","div",null,{"className":"max-w-3xl","children":[null,["$","h2",null,{"className":"mt-4 text-balance font-display text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl text-foreground","children":"Who we are"}],null]}],["$","div",null,{"className":"space-y-5 text-pretty text-base leading-relaxed sm:text-lg mt-8 text-foreground/85","children":[["$","p","0",{"children":"We are an engineering-led technology and infrastructure partner, built around practitioners rather than account managers. Every engagement, across every pillar, is scoped and delivered by people who do the technical work themselves — RF engineers, network architects, security analysts, AI engineers and technical recruiters — rather than handed to a generalist project office once a contract is signed."}],"$L9"]}],null,["$La"]]}]}]]}],"$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14"]}],["$L15","$L16"],"$L17"]}],{},null,false,null]},null,false,"$18"]},null,false,null],"$L19",false]],"m":"$undefined","G":["$1a",["$L1b"]],"S":true,"h":null,"r":"$undefined","s":"$undefined","a":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"tbWFbFw9A0dkdUMXY-EfD"}
