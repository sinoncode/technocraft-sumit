f:["$","section",null,{"className":"relative border-b py-20 sm:py-24 border-cream/10 bg-mesh-cream text-cream","children":[null,["$","div",null,{"className":"relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"max-w-3xl","children":[["$","div",null,{"className":"max-w-3xl","children":[null,["$","h2",null,{"className":"mt-4 text-balance font-display text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl text-foreground","children":"Staffing for telecom programs"}],null]}],["$","div",null,{"className":"space-y-5 text-pretty text-base leading-relaxed sm:text-lg mt-8 text-foreground/85","children":[["$","p","0",{"children":"Telecom programs are staffed in waves — a market launch may need additional RF engineers or tower technicians for a defined period. IT Staffing sources telecom-specific roles (RF engineers, fibre design engineers, tower and DAS technicians, construction and program managers) from the same technical bar used for TechnoKraft's own delivery teams."}],["$","p","1",{"children":"This matters most at the peak of a rollout, when a program needs a dozen additional field engineers for six weeks rather than a permanent headcount increase, or when a specific skill — a particular RF planning tool, a regional permitting relationship, a fibre splicing certification — is needed for one phase of a build and not the next. Sourcing that talent from a staffing partner who already understands telecom program structure removes a step most general staffing agencies cannot skip past."}]]}],["$","div",null,{"className":"mt-8 flex flex-wrap gap-x-8 gap-y-3","children":[["$","$L2b","/solutions/it-staffingIT Staffing",{"href":"/solutions/it-staffing","className":"group inline-flex items-center gap-1.5 font-display text-sm font-semibold underline-offset-4 hover:underline text-ultramarine","children":["IT Staffing",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill"