b:["$","section",null,{"className":"border-b border-ink-raised/60 bg-ink py-20 text-cream sm:py-24","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"max-w-3xl text-balance font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl","children":"Business outcomes, not just features"}],["$","ul",null,{"className":"mt-10 flex flex-wrap gap-3","children":[["$","li","Automation of a manual process",{"className":"rounded-full bg-ultramarine px-4 py-2.5 font-display text-sm font-semibold text-primary-foreground shadow-soft-primary","children":"Automation of a manual process"}],["$","li","Faster decision-making",{"className":"rounded-full border border-cream/20 bg-ink-soft px-4 py-2.5 font-display text-sm font-semibold text-cream","children":"Faster decision-making"}],["$","li","Better knowledge discovery",{"className":"rounded-full border border-cream/20 bg-ink-soft px-4 py-2.5 font-display text-sm font-semibold text-cream","children":"Better knowledge discovery"}],["$","li","Improved customer experience",{"className":"rounded-full border border-cream/20 bg-ink-soft px-4 py-2.5 font-display text-sm font-semibold text-cream","children":"Improved customer experience"}],["$","li","Measurable operational efficiency",{"className":"rounded-full border border-cream/20 bg-ink-soft px-4 py-2.5 font-display text-sm font-semibold text-cream","children":"Measurable operational efficiency"}]]}],["$","div",null,{"className":"mt-10 max-w-3xl space-y-5 text-pretty text-base leading-relaxed text-cream/80 sm:text-lg","children":[["$","p","0",{"children":"Every AI application engagement is scoped against a specific business outcome — automation of a manual process, faster decision-making, better knowledge discovery across scattered documentation, an improved customer experience, or measurable operational efficiency gains. The technology choice (which model, which architecture, whether RAG or fine-tuning is appropriate) follows from that outcome rather than driving it."}],["$","p","1",{"children":"In practice this means the first deliverable in most engagements is not code — it is a clear, written definition of what 'working' means for the specific feature: an acceptable error rate, a required response time, a defined escalation path for cases the AI should not handle alone. Building against that definition from day one avoids the common failure mode where a feature is technically functional but nobody can say whether it is actually good enough to trust with real users or real decisions."}]]}]]}]}]
c:["$","section",null,{"className":"relative border-b py-20 sm:py-24 border-cream/10 bg-mesh-cream text-cream","children":[null,["$","div",null,{"className":"relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"max-w-3xl","children":[["$","div",null,{"className":"max-w-3xl","children":[null,["$","h2",null,{"className":"mt-4 text-balance font-display text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl text-foreground","children":"Built with security and reliability in mind"}],null]}],["$","div",null,{"className":"space-y-5 text-pretty text-base leading-relaxed sm:text-lg mt-8 text-foreground/85","children":[["$","p","0",{"children":"AI applications carry considerations a standard application does not — prompt injection, data leakage through model context, and the risk of an autonomous action being taken incorrectly. These are addressed through the same engineering discipline used across TechnoKraft's other pillars: permission boundaries on what an AI assistant or agent can do, logging of AI-initiated actions, and evaluation against representative and adversarial inputs before launch, coordinated with the Cybersecurity practice where the application handles sensitive data."}]]}],["$","div",null,{"className":"mt-8 flex flex-wrap gap-x-8 gap-y-3","children":[["$","$L21","/solutions/cybersecurityCybersecurity",{"href":"/solutions/cybersecurity","className":"group inline-flex items-center gap-1.5 font-display text-sm font-semibold underline-offset-4 hover:underline text-ultramarine","children":["Cybersecurity",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5","aria-hidden":true,"children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-