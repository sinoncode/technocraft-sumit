0:{"buildId":"tbWFbFw9A0dkdUMXY-EfD","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"children":[["$","$L2",null,{"eyebrow":"Cybersecurity","title":"Enterprise Cybersecurity Services","lede":"Most breaches begin with an ordinary, preventable gap — a missed patch, an overly permissive firewall rule, a misconfigured cloud bucket — not an exotic attack. TechnoKraft's cybersecurity practice is built around finding and closing those gaps first, then maintaining the monitoring and response capability to catch what gets through. Every engagement is scoped and authorised in writing, and every finding comes with a specific remediation path, not just a severity label.","primaryCta":{"label":"Assess Your Security","topic":"cybersecurity"},"secondaryCta":{"label":"Talk to an Expert","topic":"cybersecurity"},"breadcrumbs":[{"label":"Home","href":"/"},{"label":"Solutions","href":"/solutions"},{"label":"Cybersecurity"}],"chip":"Assess → Remediate → Monitor → Respond → Sustain"}],["$","section",null,{"className":"relative border-b py-20 sm:py-24 border-cream/10 bg-mesh-cream text-cream","children":[null,["$","div",null,{"className":"relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"max-w-3xl","children":[["$","div",null,{"className":"max-w-3xl","children":[null,["$","h2",null,{"className":"mt-4 text-balance font-display text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl text-foreground","children":"The full posture, defended as one system"}],null]}],["$","div",null,{"className":"space-y-5 text-pretty text-base leading-relaxed sm:text-lg mt-8 text-foreground/85","children":[["$","p","0",{"children":"The practice covers the full posture a modern enterprise has to defend — network perimeter, endpoints, cloud workloads, identity, and the applications running on top of all of it — because attackers do not respect the boundaries between those categories either. A security assessment scoped only to the network while identity controls go unreviewed, or a cloud security review that ignores the endpoints connecting to it, leaves exactly the kind of gap most real incidents exploit."}]]}],null,"$undefined"]}]}]]}],["$","section",null,{"className":"relative border-b py-20 sm:py-24 border-cream/10 bg-mesh-cream text-cream","children":[null,["$","div",null,{"className":"relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":[["$","div",null,{"className":"max-w-3xl","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","span",null,{"className":"h-px w-8 bg-gradient-to-r from-transparent to-ultramarine","aria-hidden":true}],["$","p",null,{"className":"font-mono-tech text-xs font-medium uppercase tracking-[0.24em] text-ultramarine","children":"What we deliver"}],["$","span",null,{"className":"h-px w-8 bg-gradient-to-l from-transparent to-ultramarine hidden","aria-hidden":true}]]}],["$","h2",null,{"className":"mt-4 text-balance font-display text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl text-foreground","children":"The full posture, covered"}],null]}],["$","div",null,{"className":"mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","article","Security Assessment",{"className":"group relative flex flex-col overflow-hidden rounded-2xl border p-6 transition-all hover:-translate-y-1 border-cream/10 bg-card/80 shadow-soft hover:border-ultramarine/50 hover:shadow-soft-lg glow-border","children":[["$","span",null,{"className":"absolute inset-x-0 top-0 h-px opacity-0 transition-opacity group-hover:opacity-100 bg-gradient-to-r from-transparent via-ultramarine to-transparent","aria-hidden":true}],["$","h3",null,{"className":"font-display text-lg font-semibold leading-snug","children":"Security Assessment"}],["$","p",null,{"className":"mt-3 flex-1 text-sm leading-relaxed text-cream/70","children":"Structured review of network, application, cloud and identity security posture against recognised frameworks."}],null,null]}],"$L3","$L4","$L5","$L6","$L7","